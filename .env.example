# =====================================================================
# .env.example  ·  PLANTILLA SIN VALORES REALES
# Copie este archivo como ".env" y ajuste los valores en su equipo local.
# El archivo .env está en .gitignore y NUNCA debe subirse a GitHub.
# =====================================================================

# Clave interna de Flask (firmas de sesión). Genere una propia:
#   python -c "import secrets; print(secrets.token_hex(32))"
NOC_SECRET_KEY=REEMPLAZAR_EN_ENTORNO_LOCAL

# Ruta de la base de datos SQLite
NOC_DB_PATH=data/noc.db

# Receptor Syslog UDP de laboratorio (514 requiere privilegios; se usa 5514)
NOC_SYSLOG_HOST=127.0.0.1
NOC_SYSLOG_PORT=5514
NOC_SYSLOG_ENABLED=false

# Política de incidentes: severidad máxima (0-7) que abre incidente automáticamente
NOC_INCIDENT_MAX_SEVERITY=3

# Control de tormentas: eventos máximos por fuente por minuto
NOC_RATE_LIMIT_PER_MINUTE=60

# Deduplicación: ventana en segundos para agrupar mensajes idénticos
NOC_DEDUP_WINDOW_SECONDS=60

# Minutos sin eventos para marcar un equipo como "sin comunicación"
NOC_OFFLINE_THRESHOLD_MINUTES=30

# Horario laboral para detectar cambios fuera de horario (formato 24 h)
NOC_BUSINESS_HOURS_START=7
NOC_BUSINESS_HOURS_END=19

# ---- Corte 3 (preparado, no usado en v0.2.0) ----
TELEGRAM_BOT_TOKEN=REEMPLAZAR_EN_ENTORNO_LOCAL
TELEGRAM_CHAT_ID=REEMPLAZAR_EN_ENTORNO_LOCAL
ALERT_MIN_SEVERITY=3
ALERT_RATE_LIMIT_PER_MINUTE=5
