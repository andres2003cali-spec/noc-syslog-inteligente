# ============================================================
#  .env.example · PLANTILLA de configuración (SÍ se sube a GitHub)
#  1) Copia este archivo y renómbralo a .env
#  2) Llena los valores reales SOLO en .env (ese NO se sube)
# ============================================================

# ---------- [BASE DE DATOS] ----------
DB_PATH=data/noc.db

# ---------- [COLECTOR SYSLOG] ----------
# 0.0.0.0 = escuchar en todas las tarjetas de red del PC
SYSLOG_HOST=0.0.0.0
# 514 es el puerto estándar. Si el sistema no lo permite, usa 5140
SYSLOG_PORT=514
# false = eventos de IPs que NO están en el inventario se guardan
#         marcados como "no autorizados" y no generan alertas
ALLOW_UNKNOWN_SOURCES=false

# ---------- [POLÍTICA DE EVENTOS] ----------
# Severidad igual o menor a este número crea incidente (0=emergencia ... 7=debug)
INCIDENT_MIN_SEVERITY=2
# Minutos sin eventos para marcar un equipo como "sin comunicación"
DEVICE_TIMEOUT_MINUTES=10
# Segundos en los que un mensaje idéntico se cuenta como repetido (deduplicación)
DEDUP_WINDOW_SECONDS=60
# Eventos por minuto desde una misma IP que se consideran tormenta
STORM_THRESHOLD_PER_MINUTE=120

# ---------- [ALERTAS] ----------
# Severidad igual o menor a este número envía alerta
ALERT_MIN_SEVERITY=3
# Máximo de alertas por minuto (control de tormentas en Telegram/correo)
ALERT_RATE_LIMIT_PER_MINUTE=5

# ---------- [TELEGRAM] (Parte 7) ----------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=REEMPLAZAR_EN_ENTORNO_LOCAL
TELEGRAM_CHAT_ID=REEMPLAZAR_EN_ENTORNO_LOCAL

# ---------- [CORREO SMTP] (Parte 7) ----------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REEMPLAZAR_EN_ENTORNO_LOCAL
SMTP_PASSWORD=REEMPLAZAR_EN_ENTORNO_LOCAL
EMAIL_FROM=REEMPLAZAR_EN_ENTORNO_LOCAL
EMAIL_TO=REEMPLAZAR_EN_ENTORNO_LOCAL

# ---------- [OPERACIÓN] ----------
# Nombre del operador por defecto que queda en la auditoría
OPERADOR_DEFAULT=operador.noc
