# ============================================================
#  .gitignore · Archivos que Git NUNCA debe subir a GitHub
# ============================================================

# [SECRETOS] Tokens, contraseñas y claves (RNF-01 Seguridad)
.env
*.key
*.pem
*.pfx

# [ENTORNO VIRTUAL] Librerías instaladas localmente (se recrean con pip)
.venv/
venv/

# [PYTHON] Archivos compilados automáticamente
__pycache__/
*.pyc
.pytest_cache/

# [BASE DE DATOS] La BD se genera en cada equipo; puede contener IPs reales
data/*.db
data/*.db-wal
data/*.db-shm

# [LOGS LOCALES] Bitácoras de ejecución
*.log
!data/muestras/*.log

# [SISTEMA] Basura de Windows / macOS / editores
Thumbs.db
.DS_Store
.vscode/settings.json
